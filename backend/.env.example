# ─── Application ────────────────────────────────────────────────────────────────
APP_NAME=HairMatch
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────────
POSTGRES_USER=hairmatch
POSTGRES_PASSWORD=hairmatch_secret
POSTGRES_DB=hairmatch_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://hairmatch:hairmatch_secret@localhost:5432/hairmatch_db

# ─── Redis ───────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_DB=0
REDIS_URL=redis://:redis_secret@localhost:6379/0

# ─── Supabase ────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ─── JWT Settings ────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ────────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Rate Limiting ───────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=10/15minutes
